# ===== Client (public; embedded in the browser build) =====
# Firebase console -> Project settings -> Your apps -> Web app.
# These identify your project; security comes from Firestore rules + App Check, not secrecy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Leave empty to use the "(default)" database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# API base URL. Empty = same origin (recommended when the Express server serves the app).
VITE_API_BASE_URL=

# Fictional demo data, persona switcher and demo tour. MUST be false in production.
VITE_ENABLE_DEMO_DATA=false
VITE_MINIMUM_USER_AGE=18

# ===== Server (secret; never prefix with VITE_) =====
PORT=3000
# Firebase project ID — required by the Admin SDK to verify ID tokens and create registrations.
# Must match VITE_FIREBASE_PROJECT_ID above.
FIREBASE_PROJECT_ID=
# Path to a service-account key JSON for local development.
# On Cloud Run / GCE this is not needed — Application Default Credentials are used automatically.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
# Comma-separated browser origins allowed to call /api from another domain. Empty = same origin only.
CORS_ALLOWED_ORIGINS=

# AI CV drafting is off by default. Enable only after reviewing the provider's current data-use terms.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=8000
GEMINI_TEMPERATURE=0.3

# API abuse controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
MAX_BODY_SIZE=16kb
MAX_FIELD_CHARS=2000
MAX_SKILLS=30
